{
  "manifest_version": 3,
  "name": "Privacy Extension for WhatsApp™ Web",
  "version": "1.0.0",
  "description": "Blurs your WhatsApp Web messages and content until you hover. Perfect for privacy in public spaces. Features timed auto-blur, selective contacts, screen-share protection, blur styles, and Incognito mode.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "WhatsApp Web Privacy"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-privacy": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "Toggle privacy blur on/off"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  }
}
